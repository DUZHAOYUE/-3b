import os

#os.environ['HF_HOME'] = '/usr/local/class/media/dataset/diffusers/hub'

os.environ["CUDA_VISIBLE_DEVICES"] = "0"

outdir = "out/stable/"
os.makedirs(outdir, exist_ok=True)

import torch
from diffusers import StableDiffusionPipeline

model_id = "runwayml/stable-diffusion-v1-5"

pipe = StableDiffusionPipeline.from_pretrained(
    model_id,
    torch_dtype=torch.float16
).to("cuda")

%matplotlib inline

import matplotlib.pyplot as plt
import torch
import numpy as np

from diffusers import (
    StableDiffusionPipeline,
    DDIMScheduler,
    AutoPipelineForText2Image,
    AutoPipelineForImage2Image,
    AutoPipelineForInpainting
)

from diffusers.utils import load_image, make_image_grid

print(torch.cuda.is_available())
print(torch.cuda.get_device_name(0))

prompt1 = "a photo of an astronaut riding a horse"

img1 = pipe(prompt1).images[0]

img1.save(outdir + "english1.jpg")

plt.figure(figsize=(6,6))
plt.axis('off')
plt.imshow(img1)
plt.show()

prompt2 = "a photo of a cat eating ramen in Tokyo"

img2 = pipe(prompt2).images[0]

img2.save(outdir + "english2.jpg")

plt.figure(figsize=(6,6))
plt.axis('off')
plt.imshow(img2)
plt.show()

prompt3 = "ラーメンを食べる猫"

img3 = pipe(prompt3).images[0]

img3.save(outdir + "japanese1.jpg")

plt.figure(figsize=(6,6))
plt.axis('off')
plt.imshow(img3)
plt.show()

prompt4 = "東京の夜景を歩くアニメ少女"

img4 = pipe(prompt4).images[0]

img4.save(outdir + "japanese2.jpg")

plt.figure(figsize=(6,6))
plt.axis('off')
plt.imshow(img4)
plt.show()

prompt5 = "anime style girl in futuristic Tokyo"

img5 = pipe(prompt5).images[0]

img5.save(outdir + "anime1.jpg")

plt.figure(figsize=(6,6))
plt.axis('off')
plt.imshow(img5)
plt.show()

prompt6 = "anime style samurai with neon lights"

img6 = pipe(prompt6).images[0]

img6.save(outdir + "anime2.jpg")

plt.figure(figsize=(6,6))
plt.axis('off')
plt.imshow(img6)
plt.show()

num = 4

images = pipe(
    "a photo of dog house made of sushi",
    num_images_per_prompt=num
).images

fig, axes = plt.subplots(1, num, figsize=(16,4))

for i, img in enumerate(images):
    axes[i].imshow(img)
    axes[i].axis('off')
    img.save(outdir + f"multi_{i}.jpg")

plt.show()

del pipe
torch.cuda.empty_cache()

pipeline_text2image = AutoPipelineForText2Image.from_pretrained(
    "stabilityai/sdxl-turbo",
    torch_dtype=torch.float16,
    variant="fp16",
)

pipeline_text2image = pipeline_text2image.to("cuda")

prompt = "A teddy bear skateboarding at Times Square"

image = pipeline_text2image(
    prompt=prompt,
    guidance_scale=0.0,
    num_inference_steps=1
).images[0]

image.save(outdir + "turbo.jpg")

plt.figure(figsize=(6,6))
plt.axis('off')
plt.imshow(image)
plt.show()

del pipeline_text2image
torch.cuda.empty_cache()

pipeline_text2image = AutoPipelineForText2Image.from_pretrained(
    "stabilityai/stable-diffusion-xl-base-1.0",
    torch_dtype=torch.float16,
    variant="fp16",
    use_safetensors=True,
).to("cuda")

prompt = "a photo of delicious ramen with tonkotsu soup and big shrimps, photorealistic, 8k"

image = pipeline_text2image(prompt=prompt).images[0]

image.save(outdir + "sdxl_ramen.jpg")

plt.figure(figsize=(8,8))
plt.axis('off')
plt.imshow(image)
plt.show()

pipeline_img2img = AutoPipelineForImage2Image.from_pipe(
    pipeline_text2image
).to("cuda")

init_image = image

prompt = "udon noodle"

modified_image = pipeline_img2img(
    prompt,
    image=init_image,
    strength=0.8,
    guidance_scale=10.5
).images[0]

modified_image.save(outdir + "udon.jpg")

make_image_grid([init_image, modified_image], rows=1, cols=2)

prompt = "curry rice"

modified_image2 = pipeline_img2img(
    prompt,
    image=init_image,
    strength=0.8,
    guidance_scale=10.5
).images[0]

modified_image2.save(outdir + "curry.jpg")

make_image_grid([init_image, modified_image2], rows=1, cols=2)

pipeline_inpaint = AutoPipelineForInpainting.from_pipe(
    pipeline_text2image
).to("cuda")

img_url = "https://huggingface.co/datasets/huggingface/documentation-images/resolve/main/diffusers/sdxl-text2img.png"

mask_url = "https://huggingface.co/datasets/huggingface/documentation-images/resolve/main/diffusers/sdxl-inpaint-mask.png"

init_image = load_image(img_url)
mask_image = load_image(mask_url)

prompt = "A deep sea diver floating"

inpaint_image = pipeline_inpaint(
    prompt=prompt,
    image=init_image,
    mask_image=mask_image,
    strength=0.85,
    guidance_scale=12.5
).images[0]

inpaint_image.save(outdir + "inpaint1.jpg")

make_image_grid(
    [init_image, mask_image, inpaint_image],
    rows=1,
    cols=3
)

prompt = "A robot standing in the ocean"

inpaint_image2 = pipeline_inpaint(
    prompt=prompt,
    image=init_image,
    mask_image=mask_image,
    strength=0.85,
    guidance_scale=12.5
).images[0]

inpaint_image2.save(outdir + "inpaint2.jpg")

make_image_grid(
    [init_image, mask_image, inpaint_image2],
    rows=1,
    cols=3
)

del pipeline_text2image
del pipeline_img2img
del pipeline_inpaint

torch.cuda.empty_cache()

import os

print(os.listdir(outdir))

