import torch
import torchvision.models as models
import torchvision.transforms as transforms
from PIL import Image
import numpy as np
import matplotlib.pyplot as plt

device = torch.device("cpu")

model = models.googlenet(pretrained=True)
model.eval()
model = model.to(device)

print("GoogLeNet loaded")
transform = transforms.Compose([
    transforms.Resize((256, 256)),
    transforms.ToTensor()
])

img_path = "horse.jpg"

image = Image.open(img_path).convert('RGB')
input_tensor = transform(image).unsqueeze(0).to(device)

input_tensor.requires_grad = True

target_layer = model.inception4c

features = []

def forward_hook(module, input, output):
    features.append(output)

target_layer.register_forward_hook(forward_hook)
def deep_dream(model, input_tensor, iterations=50, lr=0.1):
    
    for i in range(iterations):
        model.zero_grad()
        features.clear()
        
        model(input_tensor)
        
        loss = features[0].norm()
        loss.backward()
        
        grad = input_tensor.grad.data
        grad /= (grad.std() + 1e-8)
        
        input_tensor.data += lr * grad
        
        input_tensor.grad.data.zero_()
        
        if i % 10 == 0:
            print(f"Iteration {i}, Loss {loss.item():.4f}")
    
    return input_tensor

    dream_tensor = deep_dream(model, input_tensor, iterations=30, lr=0.01)

    def deprocess(tensor):
    img = tensor.detach().cpu().numpy()[0]
    img = np.transpose(img, (1,2,0))
    img = np.clip(img, 0, 1)
    return img

dream_img = deprocess(dream_tensor)

plt.imshow(dream_img)
plt.title("DeepDream")
plt.axis('off')
